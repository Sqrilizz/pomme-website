---
const hash = import.meta.env.GIT_COMMIT_HASH;
const year = new Date().getFullYear();

const links = {
  "Get Started": [
    { label: "Downloads", href: "/downloads" },
    { label: "Documentation", href: "https://docs.pomme.rs", external: true },
  ],
  Community: [
    { label: "Discord", href: "https://discord.gg/ucBA55bHPR", external: true },
    { label: "GitHub", href: "https://github.com/PommeMC/Pomme-Client", external: true },
    { label: "Guidelines", href: "/community/guidelines" },
  ],
  Project: [
    { label: "News", href: "/news" },
    { label: "Source Code", href: "https://github.com/PommeMC/Pomme-Client", external: true },
  ],
};
---

<footer class="section-border border-t pt-16 pb-8" style="background: rgba(8,10,22,0.6);">
  <div class="mx-auto max-w-[1400px] px-6">
    <div class="grid gap-10 text-sm sm:grid-cols-2 md:grid-cols-4">
      <div>
        <a href="/" class="flex items-center gap-2">
          <img src="/assets/brand/pomme.png" alt="Pomme" class="pixel-render h-7" />
          <span class="font-[Rajdhani] text-lg font-bold tracking-wider uppercase">Pomme</span>
        </a>
        <p class="text-dim mt-3 leading-relaxed">A high-performance Minecraft client written in Rust.</p>
      </div>

      {
        Object.entries(links).map(([title, items]) => (
          <div>
            <span class="text-dim font-[Rajdhani] text-xs font-bold tracking-[0.15em] uppercase">{title}</span>
            <ul class="mt-4 space-y-2.5">
              {items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    target={item.external ? "_blank" : undefined}
                    rel={item.external ? "noreferrer" : undefined}
                    class="text-muted hover:text-primary-400 transition-colors"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="section-border mt-12 flex flex-col items-center justify-between gap-3 border-t pt-8 sm:flex-row">
      <span class="text-dim text-xs">
        &copy; {year} Pomme &middot; GPL-3.0
        {
          hash && (
            <a
              href={`https://github.com/PommeMC/pomme-website/commit/${hash}`}
              class="text-primary-400/40 hover:text-primary-400 ml-1.5 transition-colors"
            >
              {hash}
            </a>
          )
        }
      </span>
      <span class="text-dim text-xs"> Not affiliated with Mojang Studios or Microsoft. </span>
    </div>
  </div>
</footer>
