---
const hash = import.meta.env.GIT_COMMIT_HASH;
const year = new Date().getFullYear();

const links = {
  "Get Started": [
    { label: "Downloads", href: "/downloads" },
    { label: "Documentation", href: "https://docs.pomme.dev", external: true },
  ],
  Community: [
    { label: "Discord", href: "https://discord.gg/ucBA55bHPR", external: true },
    { label: "GitHub", href: "https://github.com/PommeMC/Pomme-Client", external: true },
    { label: "Guidelines", href: "/community/guidelines" },
  ],
  Project: [
    { label: "News", href: "/news" },
    { label: "Source Code", href: "https://github.com/PommeMC/Pomme-Client", external: true },
  ],
};
---

<footer class="section-border border-t pt-16 pb-8" style="background: rgba(8,10,22,0.6);">
  <div class="mx-auto max-w-[1400px] px-6">
    <div class="grid gap-10 text-sm sm:grid-cols-2 md:grid-cols-4">
      <div>
        <a href="/" class="flex items-center gap-2">
          <img src="/assets/brand/pomme.png" alt="Pomme" class="h-7 pixel-render" />
          <span class="font-[Rajdhani] text-lg font-bold uppercase tracking-wider">Pomme</span>
        </a>
        <p class="mt-3 leading-relaxed text-dim">
          A high-performance Minecraft client written in Rust.
        </p>
      </div>

      {Object.entries(links).map(([title, items]) => (
        <div>
          <span class="font-[Rajdhani] text-xs font-bold uppercase tracking-[0.15em] text-dim">{title}</span>
          <ul class="mt-4 space-y-2.5">
            {items.map((item) => (
              <li>
                <a
                  href={item.href}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noreferrer" : undefined}
                  class="text-muted transition-colors hover:text-primary-400"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="section-border mt-12 flex flex-col items-center justify-between gap-3 border-t pt-8 sm:flex-row">
      <span class="text-xs text-dim">
        &copy; {year} Pomme &middot; GPL-3.0
        {hash && (
          <a href={`https://github.com/PommeMC/website/commit/${hash}`} class="ml-1.5 text-primary-400/40 transition-colors hover:text-primary-400">
            {hash}
          </a>
        )}
      </span>
      <span class="text-xs text-dim">
        Not affiliated with Mojang Studios or Microsoft.
      </span>
    </div>
  </div>
</footer>
