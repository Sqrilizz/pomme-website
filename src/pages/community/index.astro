---
import { Icon } from "astro-icon/components";
import Button from "@/components/input/Button.astro";
import Layout from "@/layouts/Layout.astro";
import RevealObserver from "@/components/RevealObserver.astro";

const channels = [
  {
    name: "Discord",
    desc: "Chat with the community, get help, and follow development in real time.",
    icon: "icons/fontawesome/discord-brands",
    href: "https://discord.gg/ucBA55bHPR",
    cta: "Join Discord",
  },
  {
    name: "GitHub",
    desc: "Browse the source code, report issues, and contribute to the project.",
    icon: "icons/fontawesome/github-brands",
    href: "https://github.com/PommeMC",
    cta: "View GitHub",
  },
];

const guidelines = [
  {
    title: "Be respectful",
    desc: "Treat everyone with respect. No harassment, hate speech, or personal attacks.",
  },
  {
    title: "Stay on topic",
    desc: "Keep discussions relevant to the channel or thread you're in.",
  },
  {
    title: "No spam",
    desc: "Avoid excessive self-promotion, repeated messages, or irrelevant links.",
  },
  {
    title: "Report issues properly",
    desc: "Use GitHub issues for bugs. Include steps to reproduce, expected behavior, and logs.",
  },
];
---

<Layout
  title="Community"
  description="We're happy to have you as a part of the Pomme community!"
  keywords={["pomme", "minecraft", "client", "community"]}
  canonical="/community"
>
  <section class="section-border section-header-bg border-b">
    <div class="mx-auto max-w-[1400px] px-6 pt-20 pb-16 text-center lg:pt-28">
      <h1 class="animate-fade-up font-[Rajdhani] text-4xl font-bold tracking-wide uppercase lg:text-5xl">
        Join the <span class="text-primary-400">Community</span>
      </h1>
      <p class="animate-fade-up text-muted mx-auto mt-4 max-w-xl text-lg delay-100">
        We're happy to have you here. Connect with other players, contributors, and the development team.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-[1400px] px-6 py-24">
    <div class="grid gap-5 md:grid-cols-2">
      {
        channels.map((c, i) => (
          <a
            href={c.href}
            target="_blank"
            rel="noreferrer"
            class={`reveal reveal-delay-${i + 1} glass feature-lift group flex flex-col p-10`}
          >
            <Icon name={c.icon} class="fill-primary-400 mb-5 size-8 transition-transform duration-300 group-hover:scale-110" />
            <h3 class="font-[Rajdhani] text-2xl font-bold tracking-wide uppercase">{c.name}</h3>
            <p class="text-muted mt-2 text-sm leading-relaxed">{c.desc}</p>
            <div class="mt-auto pt-8">
              <span class="text-primary-400 inline-flex items-center gap-1.5 font-[Rajdhani] text-sm font-semibold tracking-wider uppercase">
                {c.cta}
                <svg
                  class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M7 17L17 7M17 7H7M17 7v10" />
                </svg>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section-border section-alt-bg border-t">
    <div class="mx-auto max-w-[1400px] px-6 py-24">
      <div class="reveal mb-12 flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
        <div>
          <span class="section-label">Guidelines</span>
          <h2 class="mt-3 font-[Rajdhani] text-3xl font-bold tracking-wide uppercase lg:text-4xl">Community rules</h2>
          <p class="text-muted mt-3">A few things to keep in mind when participating.</p>
        </div>
        <Button
          variant="outlined"
          href="/community/guidelines"
          className="shrink-0 rounded-[10px] px-6 py-2 font-[Rajdhani] text-sm font-semibold tracking-wider uppercase"
        >
          Full Guidelines
        </Button>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {
          guidelines.map((g, i) => (
            <div class={`reveal reveal-delay-${i + 1} glass-card flex gap-4 px-6 py-5`}>
              <span class="text-primary-400 mt-0.5">&#10003;</span>
              <div>
                <h3 class="font-[Rajdhani] text-base font-bold tracking-wide uppercase">{g.title}</h3>
                <p class="text-muted mt-1 text-sm leading-relaxed">{g.desc}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <RevealObserver />
</Layout>
