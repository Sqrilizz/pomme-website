---
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import RevealObserver from "@/components/RevealObserver.astro";

const rules = [
  {
    title: "No discriminatory language or content",
    body: "Anything that targets people for their race, gender, sexuality, disability, religion, or background is not welcome. The most severe cases are listed under Zero Tolerance below and result in an immediate ban.",
  },
  {
    title: "No NSFW or gratuitously violent content",
    body: "Keep things safe to view in any context. This applies to images, links, usernames, and avatars.",
  },
  {
    title: "No spam or flooding",
    body: "Don't post the same message across multiple channels, repost links repeatedly, or send walls of one-word messages. Bots and obvious trolling accounts are removed without warning.",
    sub: [
      "If your question hasn't been answered yet, give it some time before asking again. Most help comes from volunteers.",
      "Reposting because you didn't like the answer isn't allowed.",
    ],
  },
  {
    title: "Don't buy, sell, or recruit",
    body: "Pomme isn't a marketplace or a job board. Don't try to hire developers, advertise paid services, or sell account credentials here.",
  },
  {
    title: "Keep usernames readable",
    body: "Avoid usernames that impersonate other people, advertise other projects, or are unreadable strings of symbols. Names in non-Latin scripts are fine — names made of zalgo and decorative junk aren't.",
  },
  {
    title: "Don't ping staff or contributors without a reason",
    body: "If you need help, post in the relevant channel and wait. Pinging a developer because you want a faster response is what we're trying to avoid here. Replying to someone who's already in the conversation is fine.",
  },
  {
    title: "No political flamewars",
    body: "We're here to talk about a Minecraft client. Discussing current events in passing is fine, but channels are not the place to relitigate political controversies.",
  },
  {
    title: "No piracy or cracked accounts",
    body: "Pomme requires a real Microsoft account to play. Don't ask how to bypass authentication, share cracked launchers, or discuss workarounds for owning the game. This is a hard line and asking will get your messages removed.",
  },
  {
    title: "No bypassing Minecraft's safety features",
    body: "Don't ask for help disabling chat reporting, player reporting, or other safety features in a way that's meant to harm or harass other players. Talking about how the systems work or about their tradeoffs is fine — helping someone evade accountability is not.",
  },
  {
    title: "Don't use Pomme to grief or cheat",
    body: "Pomme is a client mod, but we don't support using it to break server rules, bypass anti-cheat, or ruin other people's games. If a server forbids modded clients, respect that. Don't share builds, configs, or guidance aimed at cheating.",
  },
];

const zeroTolerance = [
  "Racial slurs or racist speech",
  "Sexist slurs or sexist speech",
  "Homophobic or transphobic slurs or speech",
  "Ableist slurs or speech directed at people with disabilities",
  "Other forms of hate speech",
  "Doxxing — sharing someone's personal information without consent",
  "Targeted personal attacks",
];
---

<Layout
  title="Community Guidelines"
  description="The rules that keep the Pomme community welcoming, safe, and focused on the project."
  keywords={["pomme", "minecraft", "client", "community", "guidelines"]}
  canonical="/community/guidelines"
>
  <section class="section-border section-header-bg border-b">
    <div class="mx-auto max-w-4xl px-6 pt-20 pb-16 lg:pt-28">
      <h1 class="animate-fade-up font-[Rajdhani] text-4xl leading-[1.1] font-bold tracking-wide uppercase lg:text-5xl">
        Community <span class="text-primary-400">Guidelines</span>
      </h1>
      <p class="animate-fade-up text-muted mt-5 max-w-2xl text-lg delay-100">
        A short set of rules to keep the Pomme community welcoming, focused, and safe to be in.
      </p>
    </div>
  </section>

  <section class="bg-section-dark">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <div class="reveal">
        <h2 class="font-[Rajdhani] text-3xl font-bold tracking-wide uppercase">Overview</h2>
        <p class="text-muted mt-4 leading-relaxed">
          Pomme is a project people work on, contribute to, and play with — and the spaces around it should feel that way. These guidelines
          exist so newcomers feel comfortable asking questions, contributors feel respected, and everyone can focus on what we're actually
          here for. They apply to anyone participating in any official Pomme space.
        </p>
      </div>

      <div class="reveal reveal-delay-1 mt-12">
        <h2 class="font-[Rajdhani] text-3xl font-bold tracking-wide uppercase">Where these apply</h2>
        <p class="text-muted mt-4 leading-relaxed">These guidelines cover every official Pomme venue, specifically:</p>
        <ul class="text-muted mt-4 space-y-2">
          <li class="flex gap-3">
            <span class="text-primary-400 mt-1">›</span>
            <span
              >The Pomme <strong class="text-white">Discord server</strong> — every channel, voice room, thread, and DM with staff in their staff
              capacity</span
            >
          </li>
          <li class="flex gap-3">
            <span class="text-primary-400 mt-1">›</span>
            <span
              >The Pomme <strong class="text-white">GitHub organization</strong> — issues, pull requests, discussions, and code review comments</span
            >
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section-border section-alt-bg border-y">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <div class="reveal">
        <h2 class="font-[Rajdhani] text-3xl font-bold tracking-wide uppercase">The <span class="text-primary-400">rules</span></h2>
        <p class="text-muted mt-4 leading-relaxed">
          The whole list comes down to two things: <strong class="text-white">be respectful</strong> and <strong class="text-white"
            >listen to staff</strong
          >. The points below are the specific behaviors we've found we need to call out.
        </p>
      </div>

      <ol class="mt-10 space-y-6">
        {
          rules.map((rule, i) => (
            <li class={`reveal reveal-delay-${Math.min(i + 1, 4)} glass p-6`}>
              <div class="flex items-start gap-4">
                <span class="text-primary-400 font-[Rajdhani] text-2xl leading-none font-bold">{String(i + 1).padStart(2, "0")}</span>
                <div class="flex-1">
                  <h3 class="font-[Rajdhani] text-lg font-bold tracking-wide uppercase">{rule.title}</h3>
                  <p class="text-muted mt-2 leading-relaxed">{rule.body}</p>
                  {rule.sub && (
                    <ul class="text-dim mt-3 space-y-1.5 text-sm">
                      {rule.sub.map((s) => (
                        <li class="flex gap-2">
                          <span class="text-primary-400">·</span>
                          <span>{s}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="reveal text-muted mt-10 leading-relaxed">
        <p>
          See someone breaking these rules? Use the <code class="text-primary-400 rounded bg-white/5 px-1.5 py-0.5 text-sm">@mods</code> ping
          in Discord for anything urgent. For private reports, use <code class="text-primary-400 rounded bg-white/5 px-1.5 py-0.5 text-sm"
            >/modmail</code
          >
          — it doesn't notify us as fast, so save it for things that aren't time-sensitive.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-section-dark">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <div class="reveal glass border-l-4 border-red-500/50 p-8">
        <h2 class="font-[Rajdhani] text-3xl font-bold tracking-wide uppercase">Instant ban, no warning</h2>
        <p class="text-muted mt-4 leading-relaxed">
          Some behavior isn't worth talking about. If we see any of the following, the account is removed and the messages are deleted.
          There is no warning and no second chance:
        </p>
        <ul class="text-muted mt-5 space-y-2">
          {
            zeroTolerance.map((item) => (
              <li class="flex gap-3">
                <span class="mt-1 text-red-400">×</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
        <p class="text-dim mt-5 text-sm">
          This list isn't exhaustive. If something is clearly hateful or abusive and isn't listed, we'll still act on it.
        </p>
      </div>
    </div>
  </section>

  <section class="section-border section-alt-bg border-y">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <div class="reveal">
        <h2 class="font-[Rajdhani] text-3xl font-bold tracking-wide uppercase">Ban appeals</h2>
        <p class="text-muted mt-4 leading-relaxed">
          If you've been banned and think it was a mistake, you can appeal once. Join the
          <a
            href="https://discord.gg/cTKAXWy5eP"
            target="_blank"
            rel="noreferrer"
            class="text-primary-400 hover:text-primary-500 transition-colors"
          >
            appeal server
          </a>
          and follow the instructions there. You only get one shot, so make it count.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-section-dark">
    <div class="mx-auto max-w-4xl px-6 py-14">
      <div class="reveal text-dim flex flex-col gap-3 text-sm sm:flex-row sm:items-center sm:justify-between">
        <span>
          Last updated <code class="text-primary-400 rounded bg-white/5 px-1.5 py-0.5">2026-04-13</code>
        </span>
        <a
          href="https://creativecommons.org/licenses/by-sa/4.0/?ref=chooser-v1"
          target="_blank"
          rel="noreferrer"
          class="text-primary-400 hover:text-primary-500 inline-flex items-center gap-2 transition-colors"
        >
          Licensed under CC BY-SA 4.0
          <Icon name="icons/cc/cc" class="size-5 align-sub" />
          <Icon name="icons/cc/by" class="size-5 align-sub" />
          <Icon name="icons/cc/sa" class="size-5 align-sub" />
        </a>
      </div>
    </div>
  </section>

  <RevealObserver />
</Layout>
