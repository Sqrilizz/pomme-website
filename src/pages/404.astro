---
import Button from "@/components/input/Button.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="404 · Not found" description="The page you're looking for doesn't exist." keywords={["404", "not found"]} canonical="/404">
  <section class="bg-section-dark">
    <div class="mx-auto flex min-h-[calc(100vh-14rem)] max-w-[1400px] flex-col items-center justify-center px-6 py-24 text-center">
      <div class="animate-fade-up text-primary-400 font-[Rajdhani] text-[8rem] leading-none font-bold tracking-wide lg:text-[12rem]">
        404
      </div>

      <h1 class="animate-fade-up mt-2 font-[Rajdhani] text-2xl font-bold tracking-wide uppercase delay-100 lg:text-3xl">
        Page <span class="text-primary-400">not found</span>
      </h1>

      <p class="animate-fade-up text-muted mt-4 max-w-md delay-200">
        The page you're looking for doesn't exist, has been moved, or is hiding behind a chunk that hasn't loaded yet.
      </p>

      <div class="animate-fade-up mt-10 flex flex-col gap-4 delay-300 sm:flex-row">
        <Button
          variant="filled"
          href="/"
          className="rounded-[10px] px-8 py-2.5 font-[Rajdhani] text-base font-bold tracking-wider uppercase"
        >
          Back to home
        </Button>
        <Button
          variant="outlined"
          href="/downloads"
          className="rounded-[10px] px-8 py-2.5 font-[Rajdhani] text-base font-semibold tracking-wider uppercase"
        >
          Download Pomme
        </Button>
      </div>
    </div>
  </section>
</Layout>
