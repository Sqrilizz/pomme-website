---
import { Icon } from "astro-icon/components";
import Button from "@/components/input/Button.astro";
import Layout from "@/layouts/Layout.astro";
import RevealObserver from "@/components/RevealObserver.astro";
---

<Layout
  title="Home"
  description="Pomme is a high-performance Minecraft client written in Rust with Vulkan rendering."
  keywords={["pomme", "minecraft", "client", "rust", "vulkan", "performance"]}
  canonical="/"
>
  <section class="bg-section-dark">
    <header class="mx-auto grid max-w-[1400px] items-center gap-10 px-6 pt-20 pb-24 lg:grid-cols-2 lg:gap-16 lg:pt-28 lg:pb-36">
      <div>
        <h1 class="animate-fade-up font-[Rajdhani] text-5xl leading-[1.1] font-bold tracking-wide uppercase delay-100 lg:text-7xl">
          Minecraft,<br class="hidden lg:inline" />
          <span class="text-primary-400"> reimagined.</span>
        </h1>

        <p class="animate-fade-up text-muted mt-6 max-w-xl text-lg leading-relaxed delay-200">
          A from-scratch Minecraft client built in Rust. Vulkan-powered rendering, vanilla server compatibility, and a fraction of the
          memory footprint - no JVM required.
        </p>

        <div class="animate-fade-up mt-10 flex flex-col gap-4 delay-300 sm:flex-row">
          <Button variant="filled" size="lg" href="/downloads">Download</Button>
          <Button variant="outlined" size="lg" href="https://github.com/PommeMC/Pomme-Client" external>Source Code</Button>
        </div>
      </div>

      <div class="animate-fade-up border-subtle overflow-hidden rounded-[14px] delay-300">
        <img src="/assets/screenshot.png" alt="Pomme client screenshot" class="h-full w-full object-cover" />
      </div>
    </header>
  </section>

  <section class="bg-section-light section-border border-y">
    <div class="mx-auto max-w-[1400px] px-6 py-24">
      <div class="mb-10 text-center">
        <span class="section-label">About Pomme</span>
      </div>
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        <div class="text-center">
          <div class="text-primary-400 font-[Rajdhani] text-3xl font-bold">Rust</div>
          <p class="text-muted mt-2 text-sm leading-relaxed">
            Built from scratch in Rust. No JVM, no garbage collector, no runtime overhead.
          </p>
        </div>
        <div class="text-center">
          <div class="text-primary-400 font-[Rajdhani] text-3xl font-bold">Vulkan</div>
          <p class="text-muted mt-2 text-sm leading-relaxed">GPU-accelerated rendering through Vulkan for maximum frame throughput.</p>
        </div>
        <div class="text-center">
          <div class="text-primary-400 font-[Rajdhani] text-3xl font-bold">Vanilla</div>
          <p class="text-muted mt-2 text-sm leading-relaxed">
            Connects to any vanilla server with full protocol, auth, and encryption support.
          </p>
        </div>
        <div class="text-center">
          <div class="text-primary-400 font-[Rajdhani] text-3xl font-bold">Open Source</div>
          <p class="text-muted mt-2 text-sm leading-relaxed">
            GPL-3.0 licensed. Read the code, contribute, or fork it and make it your own.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-section-dark">
    <div class="mx-auto max-w-[1400px] px-6 py-24">
      <div class="reveal mb-16 text-center">
        <span class="section-label">Head to head</span>
        <h2 class="mt-3 font-[Rajdhani] text-3xl font-bold tracking-wide uppercase lg:text-4xl">
          How Pomme <span class="text-primary-400">compares</span>
        </h2>
        <p class="text-muted mt-3">See how a native Rust client stacks up against the competition.</p>
      </div>

      <div class="reveal reveal-delay-1 glass overflow-hidden overflow-x-auto">
        <div class="comparison-grid" style="min-width: 600px;">
          <div class="cell cell-header text-dim"></div>
          <div class="cell cell-header text-center">Vanilla</div>
          <div class="cell cell-header text-center">Lunar</div>
          <div class="cell cell-header text-center">Badlion</div>
          <div class="cell cell-header text-primary-400 text-center">Pomme</div>

          <div class="cell cell-label">Language</div>
          <div class="cell cell-java text-center">-</div>
          <div class="cell cell-java text-center">-</div>
          <div class="cell cell-java text-center">-</div>
          <div class="cell cell-pomme text-center">-</div>

          <div class="cell cell-label row-highlight">Renderer</div>
          <div class="cell cell-java row-highlight text-center">-</div>
          <div class="cell cell-java row-highlight text-center">-</div>
          <div class="cell cell-java row-highlight text-center">-</div>
          <div class="cell cell-pomme row-highlight text-center">-</div>

          <div class="cell cell-label">RAM usage</div>
          <div class="cell cell-java text-center">-</div>
          <div class="cell cell-java text-center">-</div>
          <div class="cell cell-java text-center">-</div>
          <div class="cell cell-pomme text-center">-</div>

          <div class="cell cell-label row-highlight">Startup time</div>
          <div class="cell cell-java row-highlight text-center">-</div>
          <div class="cell cell-java row-highlight text-center">-</div>
          <div class="cell cell-java row-highlight text-center">-</div>
          <div class="cell cell-pomme row-highlight text-center">-</div>

          <div class="cell cell-label">Runtime</div>
          <div class="cell cell-java text-center">-</div>
          <div class="cell cell-java text-center">-</div>
          <div class="cell cell-java text-center">-</div>
          <div class="cell cell-pomme text-center">-</div>

          <div class="cell cell-label row-highlight">GC pauses</div>
          <div class="cell cell-java row-highlight text-center">-</div>
          <div class="cell cell-java row-highlight text-center">-</div>
          <div class="cell cell-java row-highlight text-center">-</div>
          <div class="cell cell-pomme row-highlight text-center">-</div>

          <div class="cell cell-label">Open source</div>
          <div class="cell cell-java text-center">-</div>
          <div class="cell cell-java text-center">-</div>
          <div class="cell cell-java text-center">-</div>
          <div class="cell cell-pomme text-center">-</div>

          <div class="cell cell-label row-highlight">Install size</div>
          <div class="cell cell-java row-highlight text-center">-</div>
          <div class="cell cell-java row-highlight text-center">-</div>
          <div class="cell cell-java row-highlight text-center">-</div>
          <div class="cell cell-pomme row-highlight text-center">-</div>

          <div class="cell cell-label" style="border-bottom: none;">Anti-cheat</div>
          <div class="cell cell-java text-center" style="border-bottom: none;">-</div>
          <div class="cell cell-java text-center" style="border-bottom: none;">-</div>
          <div class="cell cell-java text-center" style="border-bottom: none;">-</div>
          <div class="cell cell-pomme text-center" style="border-bottom: none;">-</div>
        </div>
      </div>

      <div class="mt-6 text-center">
        <button
          id="test-settings-btn"
          class="btn btn-outline btn-gray rounded-[10px] px-6 py-2 font-[Rajdhani] text-sm font-semibold tracking-wider uppercase"
        >
          Test Settings
        </button>
      </div>

      <dialog id="test-settings-dialog" class="glass-heavy m-auto max-w-xl rounded-[14px] p-0 backdrop:bg-[#080a16]/80">
        <div class="p-8">
          <div class="mb-6 flex items-center justify-between">
            <h3 class="font-[Rajdhani] text-xl font-bold tracking-wide text-white uppercase">Test Settings</h3>
            <button
              id="test-settings-close"
              class="flex h-8 w-8 items-center justify-center rounded-[8px] text-sm transition-colors"
              style="color: #8890b0; background: rgba(255,255,255,0.05);"
              aria-label="Close"
            >
              &#10005;
            </button>
          </div>
          <p class="text-muted mb-6 text-sm">
            All clients were tested on the same machine with identical settings to ensure a fair comparison.
          </p>
          <div class="space-y-3">
            {
              ["CPU", "GPU", "RAM", "Graphics", "Render Distance", "Resolution"].map((label) => (
                <div class="glass-card flex items-center justify-between rounded-[10px] px-4 py-3">
                  <span class="text-muted text-sm">{label}</span>
                  <span class="font-[Rajdhani] text-sm font-semibold text-white">-</span>
                </div>
              ))
            }
          </div>
        </div>
      </dialog>
    </div>
  </section>

  <section class="bg-section-light">
    <div class="mx-auto max-w-[1400px] px-6 py-24">
      <div class="reveal mb-16 text-center">
        <span class="section-label">Features</span>
        <h2 class="mt-3 font-[Rajdhani] text-3xl font-bold tracking-wide uppercase lg:text-4xl">
          Why <span class="text-primary-400">Pomme</span>?
        </h2>
        <p class="text-muted mt-3">Built different from the ground up.</p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <div class="reveal reveal-delay-1 glass feature-lift p-7">
          <div class="feature-icon">
            <Icon name="icons/heroicons/bolt" class="h-5 w-5" />
          </div>
          <h3 class="font-[Rajdhani] text-lg font-bold tracking-wide uppercase">Vulkan Rendering</h3>
          <p class="text-muted mt-2 text-sm leading-relaxed">
            Direct GPU access via Vulkan. Compute-shader frustum culling, greedy meshing, and bucket-pooled buffers for maximum throughput.
          </p>
        </div>

        <div class="reveal reveal-delay-2 glass feature-lift p-7">
          <div class="feature-icon">
            <Icon name="icons/heroicons/globe-americas" class="h-5 w-5" />
          </div>
          <h3 class="font-[Rajdhani] text-lg font-bold tracking-wide uppercase">Vanilla Compatible</h3>
          <p class="text-muted mt-2 text-sm leading-relaxed">
            Connects to any vanilla server out of the box. Full protocol implementation with authentication, encryption, and compression.
          </p>
        </div>

        <div class="reveal reveal-delay-3 glass feature-lift p-7">
          <div class="feature-icon">
            <Icon name="icons/heroicons/code-bracket" class="h-5 w-5" />
          </div>
          <h3 class="font-[Rajdhani] text-lg font-bold tracking-wide uppercase">Native Binary</h3>
          <p class="text-muted mt-2 text-sm leading-relaxed">
            No JVM. No garbage collector. Compiles to a single native binary that starts instantly with zero warm-up time.
          </p>
        </div>

        <div class="reveal reveal-delay-1 glass feature-lift p-7">
          <div class="feature-icon">
            <Icon name="icons/heroicons/shield-check" class="h-5 w-5" />
          </div>
          <h3 class="font-[Rajdhani] text-lg font-bold tracking-wide uppercase">Memory Safe</h3>
          <p class="text-muted mt-2 text-sm leading-relaxed">
            Written in Rust -no buffer overflows, no use-after-free, no data races. Safety guarantees enforced at compile time.
          </p>
        </div>

        <div class="reveal reveal-delay-2 glass feature-lift p-7">
          <div class="feature-icon">
            <Icon name="icons/heroicons/photo" class="h-5 w-5" />
          </div>
          <h3 class="font-[Rajdhani] text-lg font-bold tracking-wide uppercase">Resource Packs</h3>
          <p class="text-muted mt-2 text-sm leading-relaxed">
            Full resource pack loading with hot-reload support. Swap textures, models, and shaders without restarting.
          </p>
        </div>

        <div class="reveal reveal-delay-3 glass feature-lift p-7">
          <div class="feature-icon">
            <Icon name="icons/heroicons/key" class="h-5 w-5" />
          </div>
          <h3 class="font-[Rajdhani] text-lg font-bold tracking-wide uppercase">Microsoft Auth</h3>
          <p class="text-muted mt-2 text-sm leading-relaxed">
            Secure authentication through the OS keyring. Your credentials are stored safely by your operating system, not in plain text.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-section-dark">
    <div class="mx-auto max-w-[1400px] px-6 py-24">
      <div class="reveal mb-16 text-center">
        <span class="section-label">In action</span>
        <h2 class="mt-3 font-[Rajdhani] text-3xl font-bold tracking-wide uppercase lg:text-4xl">
          See it for <span class="text-primary-400">yourself</span>
        </h2>
      </div>

      <div class="grid gap-4 md:grid-cols-3">
        <div class="reveal reveal-delay-1 border-subtle overflow-hidden rounded-[14px]">
          <div class="glass-bg flex aspect-video items-center justify-center">
            <span class="text-dim font-[Rajdhani] text-sm tracking-wider uppercase">Screenshot 1</span>
          </div>
        </div>
        <div class="reveal reveal-delay-2 border-subtle overflow-hidden rounded-[14px]">
          <div class="glass-bg flex aspect-video items-center justify-center">
            <span class="text-dim font-[Rajdhani] text-sm tracking-wider uppercase">Screenshot 2</span>
          </div>
        </div>
        <div class="reveal reveal-delay-3 border-subtle overflow-hidden rounded-[14px]">
          <div class="glass-bg flex aspect-video items-center justify-center">
            <span class="text-dim font-[Rajdhani] text-sm tracking-wider uppercase">Screenshot 3</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-section-light">
    <div class="mx-auto max-w-[1400px] px-6 py-24">
      <div class="reveal mb-16 text-center">
        <span class="section-label">FAQ</span>
        <h2 class="mt-3 font-[Rajdhani] text-3xl font-bold tracking-wide uppercase lg:text-4xl">
          Common <span class="text-primary-400">questions</span>
        </h2>
      </div>

      <div class="mx-auto max-w-3xl space-y-3">
        <details class="reveal reveal-delay-1 group glass-card">
          <summary
            class="flex cursor-pointer items-center justify-between px-6 py-5 font-[Rajdhani] text-base font-bold tracking-wide uppercase select-none"
          >
            What servers can I connect to?
            <svg
              class="h-4 w-4 shrink-0 transition-transform duration-200 group-open:rotate-180"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"><path d="M19 9l-7 7-7-7"></path></svg
            >
          </summary>
          <div class="text-muted px-6 pb-5 text-sm leading-relaxed">
            Pomme implements the full vanilla Minecraft protocol, so it can connect to any vanilla or compatible server. Modded servers that
            require client-side mods are not supported.
          </div>
        </details>

        <details class="reveal reveal-delay-2 group glass-card">
          <summary
            class="flex cursor-pointer items-center justify-between px-6 py-5 font-[Rajdhani] text-base font-bold tracking-wide uppercase select-none"
          >
            Is my Microsoft account safe?
            <svg
              class="h-4 w-4 shrink-0 transition-transform duration-200 group-open:rotate-180"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"><path d="M19 9l-7 7-7-7"></path></svg
            >
          </summary>
          <div class="text-muted px-6 pb-5 text-sm leading-relaxed">
            Yes. Pomme authenticates through the official Microsoft OAuth flow and stores tokens in your operating system's keyring (Windows
            Credential Manager, macOS Keychain, or Linux Secret Service). Your password is never stored or handled by Pomme directly.
          </div>
        </details>

        <details class="reveal reveal-delay-3 group glass-card">
          <summary
            class="flex cursor-pointer items-center justify-between px-6 py-5 font-[Rajdhani] text-base font-bold tracking-wide uppercase select-none"
          >
            Does it support mods?
            <svg
              class="h-4 w-4 shrink-0 transition-transform duration-200 group-open:rotate-180"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"><path d="M19 9l-7 7-7-7"></path></svg
            >
          </summary>
          <div class="text-muted px-6 pb-5 text-sm leading-relaxed">
            Not currently. Pomme is a from-scratch implementation and does not run Java, so Fabric/Forge mods are not compatible. Resource
            packs are fully supported with hot-reload.
          </div>
        </details>

        <details class="reveal reveal-delay-4 group glass-card">
          <summary
            class="flex cursor-pointer items-center justify-between px-6 py-5 font-[Rajdhani] text-base font-bold tracking-wide uppercase select-none"
          >
            What platforms are supported?
            <svg
              class="h-4 w-4 shrink-0 transition-transform duration-200 group-open:rotate-180"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"><path d="M19 9l-7 7-7-7"></path></svg
            >
          </summary>
          <div class="text-muted px-6 pb-5 text-sm leading-relaxed">
            Windows 10+, Linux (x86_64, glibc 2.31+), and macOS (Apple Silicon and Intel). Any system with a Vulkan 1.2 compatible GPU
            should work.
          </div>
        </details>

        <details class="reveal reveal-delay-5 group glass-card">
          <summary
            class="flex cursor-pointer items-center justify-between px-6 py-5 font-[Rajdhani] text-base font-bold tracking-wide uppercase select-none"
          >
            Will I get banned for using Pomme?
            <svg
              class="h-4 w-4 shrink-0 transition-transform duration-200 group-open:rotate-180"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"><path d="M19 9l-7 7-7-7"></path></svg
            >
          </summary>
          <div class="text-muted px-6 pb-5 text-sm leading-relaxed">
            Pomme authenticates through Microsoft and follows the vanilla protocol exactly. However, some third-party servers with strict
            anti-cheat may flag non-standard clients. Use at your own discretion on such servers.
          </div>
        </details>
      </div>
    </div>
  </section>

  <section class="bg-section-dark">
    <div class="mx-auto max-w-[1400px] px-6 py-24 text-center">
      <div class="reveal">
        <h2 class="font-[Rajdhani] text-3xl font-bold tracking-wide uppercase lg:text-5xl">
          Ready to <span class="text-primary-400">play</span>?
        </h2>
        <p class="text-muted mx-auto mt-4 max-w-lg">
          GPL-3.0 licensed and developed in the open. Download the client, read the code, or join the community.
        </p>
        <div class="mt-10 flex flex-col justify-center gap-4 sm:flex-row">
          <Button variant="filled" size="lg" href="/downloads">Download Pomme</Button>
          <Button variant="outlined" size="lg" href="https://discord.gg/ucBA55bHPR" external>Join Discord</Button>
        </div>
      </div>
    </div>
  </section>
  <RevealObserver />
</Layout>

<script>
  const dialog = document.getElementById("test-settings-dialog") as HTMLDialogElement;

  function closeDialog() {
    dialog.classList.add("closing");
    dialog.addEventListener(
      "animationend",
      () => {
        dialog.classList.remove("closing");
        dialog.close();
      },
      { once: true }
    );
  }

  document.getElementById("test-settings-btn")?.addEventListener("click", () => dialog?.showModal());
  document.getElementById("test-settings-close")?.addEventListener("click", closeDialog);
  dialog?.addEventListener("click", (e) => {
    if (e.target === dialog) closeDialog();
  });
</script>
